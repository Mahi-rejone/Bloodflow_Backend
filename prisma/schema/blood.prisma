model BloodRequest {
  id              String                 @id @default(uuid())
  requesterId     String
  bloodGroup      BloodGroup
  unitsNeeded     Int
  hospital        String
  district        String
  town            String
  address         String
  createdAt       DateTime               @default(now())
  neededAt        DateTime
  isDeleted       Boolean                @default(false)
  state           String
  status          BloodRequestStatus     @default(PENDING)
  donationHistory BloodDonationHistory[]
  requester       User                   @relation("Requester", fields: [requesterId], references: [id])

  @@map("BloodRequests")
}

model BloodDonationHistory {
  id           String         @id @default(uuid())
  donorId      String
  recipientId  String
  donationDate DateTime       @default(now())
  unitDonated  Int
  reqId        String
  status       DonationStatus @default(IN_PROGRESS)
  otp          String
  otpExpiresAt DateTime
  donor        User           @relation("Donor", fields: [donorId], references: [id])
  recipient    User           @relation("Recipient", fields: [recipientId], references: [id])
  bloodRequest BloodRequest   @relation(fields: [reqId], references: [id])
}
