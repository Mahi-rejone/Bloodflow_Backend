generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  BLOOD_BANK_MANAGER
  HOSPITAL_REPRESENTATIVE
  DONOR_RECIPIENT
}

enum UserStatus {
  ACTIVE
  BLOCK
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

model User {
  id        String     @id @default(uuid())
  username  String     @unique
  password  String
  email     String     @unique
  status    UserStatus @default(ACTIVE)
  role      UserRole
  isDeleted Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // one-to-one: each user has exactly one donor/recipient profile
  profileId String?               @unique
  profile   DonorRecipientProfile? @relation(fields: [profileId], references: [id])

  // reverse relations
  bloodRequests    BloodRequest[]     @relation("Requester")
  donationsGiven   DonationHistory[]  @relation("Donor")
  donationsReceived DonationHistory[] @relation("Recipient")
  blogs            Blog[]
  events           Event[]
}

model DonorRecipientProfile {
  id                String     @id @default(uuid())
  img               String?
  bloodGroup        BloodGroup
  phoneNumber       String
  guardianNumber    String?
  numberOfDonation  Int        @default(0)
  stateProvince     String
  district          String
  town              String
  address           String
  dateOfBirth       DateTime
  gender            String

  user User?
}

model BloodRequest {
  id           String     @id @default(uuid())
  requesterId  String
  requester    User       @relation("Requester", fields: [requesterId], references: [id])
  bloodGroup   BloodGroup
  unitsNeeded  Int
  hospital     String
  district     String
  town         String
  address      String
  createdAt    DateTime   @default(now())
  neededAt     DateTime

  donationHistory DonationHistory[]
}

model DonationHistory {
  id            String   @id @default(uuid())
  donorId       String
  donor         User     @relation("Donor", fields: [donorId], references: [id])
  recipientId   String
  recipient     User     @relation("Recipient", fields: [recipientId], references: [id])
  donationDate  DateTime @default(now())
  unitDonated   Int
  reqId         String
  bloodRequest  BloodRequest @relation(fields: [reqId], references: [id])
}

model Blog {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  coverImage  String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id           String   @id @default(uuid())
  title        String
  description  String
  location     String
  coverImage   String?
  eventDate    DateTime
  organizerId  String
  organizer    User     @relation(fields: [organizerId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
